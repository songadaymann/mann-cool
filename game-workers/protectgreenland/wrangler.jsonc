{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mann-cool-protectgreenland",
  "main": "src/index.js",
  "compatibility_date": "2026-07-15",
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mann.cool/protectgreenland",
      "zone_name": "mann.cool"
    },
    {
      "pattern": "mann.cool/protectgreenland/*",
      "zone_name": "mann.cool"
    },
    {
      "pattern": "www.mann.cool/protectgreenland",
      "zone_name": "mann.cool"
    },
    {
      "pattern": "www.mann.cool/protectgreenland/*",
      "zone_name": "mann.cool"
    }
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
