{
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/pong",
      "destination": "https://pong-gold-omega.vercel.app"
    },
    {
      "source": "/pong/(.*)",
      "destination": "https://pong-gold-omega.vercel.app/$1"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
